# ============================================================
# TrendDrop — Environment Configuration Template
# Copy to .env and fill in real values. NEVER commit .env.
# ============================================================

# ---------- Server ----------
# Port the Express server listens on (server/server.js). Render injects PORT automatically.
PORT=5000
NODE_ENV=development
# Primary Mongo connection string (Atlas/MongoDB). Your value for MONGODB_URI is the
# test/dedicated DB name; MONGO_URI is the primary. Both are honored across the app.
MONGO_URI=mongodb+srv://username:password@cluster.mongodb.net/trenddrop?retryWrites=true&w=majority
MONGODB_URI=mongodb://localhost:27017/trend-drop
JWT_SECRET=your-random-jwt-secret-here
# Comma-separated list of emails with admin privileges (server/middleware/admin.js)
ADMIN_EMAILS=admin@example.com,moderator@example.com

# ---------- Client / URLs ----------
# CORS origin for WebSocket + API (server/websocket.js)
CLIENT_URL=http://localhost:3000
# Base URL used in all email links + post-verification redirects (server/config/email.js, server/server.js)
FRONTEND_URL=http://localhost:3000
# Client build-time override used by client/src/services/api.js.
# REQUIRED for production iOS/Android release builds: the Capacitor WebView
# hostname is ALWAYS "localhost", so without this env var a production app
# would call the phone's own localhost. Build with:
#   REACT_APP_API_URL=https://your-api.example.com/api npm run build
# (web builds still use the relative /api served by Express; leave blank for web dev)
# For production mobile builds (iOS/Android), uncomment and set to your actual Render URL:
# REACT_APP_API_URL=https://trend-drop.onrender.com/api
# Deep-link/callback scheme for native (Capacitor) builds (client/src/context/AuthContext.js).
# Defaults to 'auravest://callback' if unset.
REACT_APP_NATIVE_REDIRECT_URI=your-scheme://callback

# ---------- Cloudinary (Image Uploads) ----------
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# ---------- Stripe (Payments) ----------
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key
STRIPE_PUBLISHABLE_KEY=pk_test_your_stripe_publishable_key
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret

# ---------- Email (Brevo — free 300/day transactional tier) ----------
# Used by server/config/email.js for verification, password reset, order confirmations
BREVO_API_KEY=xkeysib-your_brevo_api_key
BREVO_SENDER_EMAIL=your-verified-sender@example.com

# ---------- Google OAuth (Sign-In With Google) ----------
# Server-side verification (server/routes/auth.js)
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
# Client-side Identity Services init (client/src/context/AuthContext.js — REACT_APP_ prefixed)
REACT_APP_GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com

# ---------- Apple Sign-In (client/src/context/AuthContext.js) ----------
APPLE_CLIENT_ID=your_apple_service_id
REACT_APP_APPLE_CLIENT_ID=your_apple_service_id
REACT_APP_APPLE_REDIRECT_URI=https://trend-drop.onrender.com/callback

# ---------- Facebook Login (client/src/context/AuthContext.js) ----------
FB_APP_ID=your_facebook_app_id
FB_APP_SECRET=your_facebook_app_secret
REACT_APP_FACEBOOK_APP_ID=your_facebook_app_id

# ---------- Legacy Email SMTP (optional fallback) ----------
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password