{
  "name": "trend-drop",
  "version": "1.0.0",
  "description": "TrendDrop - Social Commerce Marketplace for Fashion",
  "scripts": {
    "start": "node server/server.js",
    "server": "cd server && npm run dev",
    "client": "cd client && npm start",
    "dev": "concurrently \"npm run server\" \"npm run client\"",
    "install-all": "npm install && cd server && npm install && cd ../client && npm install",
    "build": "cd client && npm run build",
    "heroku-postbuild": "npm run build",
    "start:all": "bash start.sh",
    "test:server": "cd server && npm run test:ci",
    "test:e2e": "npx playwright test",
    "test:e2e:prod": "E2E_RUN_ID=$(date +%Y%m%d%H%M%S) npx playwright test --config=e2e/playwright.prod.config.js",
    "test:ci": "npm run test:server && npm run build && npm run test:e2e"
  },
  "engines": {
    "node": ">=14.0.0"
  },
  "dependencies": {
    "concurrently": "^10.0.4"
  },
  "devDependencies": {
    "@playwright/test": "^1.49.1"
  }
}
